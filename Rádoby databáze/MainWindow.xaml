<Window x:Class="Rádoby_databáze.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rádoby_databáze"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!--levý grid-->
        <Grid Grid.Column="0">
            <DataGrid x:Name="Kosticky"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"/>


        </Grid>
        <!--pravý grid-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Nadpis-->
            <TextBlock Grid.Row="0"
                       Text="Databáze kostiček"
                       FontSize="35"
                       FontWeight="SemiBold">
            </TextBlock>
            <!--Název-->
            <TextBlock
                       Text="Název:"
                       FontSize="18" Margin="0,48,0,25" Grid.RowSpan="2"/>
            <!--Název textbox-->
            <TextBox Grid.Row="1" Margin="0,24,0,5"/>
            <!--Druh-->
            <TextBlock Grid.Row="1"
                       Text="Druh:"
                       FontSize="18" Margin="0,48,0,48" Grid.RowSpan="3">
            </TextBlock>
            <!--Druh textbox-->
            <TextBox Grid.Row="2" Margin="0,25,0,5"/>
            <TextBlock HorizontalAlignment="Center" Margin="0,3,0,0" Grid.Row="3" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="cs-cz"/></TextBlock>
            <!--Výrobce-->
            <TextBlock Grid.Row="3" 
                     Margin="0,1,0,24" 
                     Text="Výrobce"
                     FontSize="18" RenderTransformOrigin="0.5,0.513" />
            <TextBox HorizontalAlignment="Center" 
                     Margin="0,30,0,0" 
                     Grid.RowSpan="2" 
                     Grid.Row="3" TextWrapping="Wrap" 
                     VerticalAlignment="Top" 
                     Width="400" 
                     TextChanged="TextBox_TextChanged"/>
            <!--Cena-->
            <TextBlock
                    Grid.Row="4"
                Text="Cena"
                FontSize="18"
            TextWrapping="Wrap"
                 VerticalAlignment="Top"
                Width="61"
                Margin="0,5,339,0"/>
            <TextBox Grid.Row="4" TextWrapping="Wrap" 
                HorizontalAlignment="Center" Margin="0,34,0,0" 
                      VerticalAlignment="Top" Width="400" Grid.RowSpan="2"/>


        </Grid>
    </Grid>



</Window>
